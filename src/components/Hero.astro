---
import { DOWNLOAD_URL } from '../config';
import { VERSION } from '../version';
---

<section class="hero">
  <img
    src="/app-icon.png"
    alt="Farthing app icon"
    class="hero__logo"
    width="120"
    height="120"
  />
  <div class="hero__text">
    <h1 class="hero__headline">Farthing</h1>
    <p class="hero__tagline">
      A Mac app for tracking spend, sessions, and tokens in Claude Code. Every farthing, accounted for.
    </p>
    <a href={DOWNLOAD_URL} class="btn-download" download target="_blank" rel="noopener noreferrer">
      <span class="btn-download__main">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="7 10 12 15 17 10" />
          <line x1="12" y1="15" x2="12" y2="3" />
        </svg>
        Download for Mac
      </span>
      <span class="btn-download__version">v{VERSION}</span>
    </a>
  </div>
</section>
