<canvas id="gradient-canvas" aria-hidden="true"></canvas>

<style>
  #gradient-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    --gradient-color-1: #bfeef5;
    --gradient-color-2: #cdeecd;
    --gradient-color-3: #f3f0fb;
    --gradient-color-4: #f7c7e8;
  }
</style>

<script>
  const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (mq.matches) {
    const canvas = document.getElementById('gradient-canvas')!;
    canvas.style.cssText +=
      'background: linear-gradient(135deg, #bfeef5 0%, #cdeecd 35%, #f3f0fb 65%, #f7c7e8 100%);';
  } else {
    const { Gradient } = await import('whatamesh');
    new Gradient().initGradient('#gradient-canvas');
  }
</script>
