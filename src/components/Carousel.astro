---
interface Slide {
  src: string;
  alt: string;
}

interface Props {
  slides?: Slide[];
}

const {
  slides = [
    { src: '/screenshots/sessions.png', alt: 'Sessions view' },
    { src: '/screenshots/cost-over-time.png', alt: 'Cost over time' },
    { src: '/screenshots/tokens-cache.png', alt: 'Tokens & cache' },
    { src: '/screenshots/projects.png', alt: 'Projects' },
    { src: '/screenshots/menubar-popover.png', alt: 'Menu bar' },
  ],
} = Astro.props;
---

<div class="carousel-section">
  <div class="card">
    <div class="embla" id="embla">
      <div class="embla__viewport" id="embla-viewport">
        <div class="embla__container" id="embla-container">
          {
            slides.map((slide, i) => (
              <div class="embla__slide">
                <img
                  src={slide.src}
                  alt={slide.alt}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  onerror="this.style.background='rgba(0,0,0,0.06)';this.removeAttribute('src')"
                />
              </div>
            ))
          }
        </div>
      </div>

      <button class="embla__btn embla__btn--prev" id="embla-prev" aria-label="Previous screenshot">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <button class="embla__btn embla__btn--next" id="embla-next" aria-label="Next screenshot">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

    </div>
  </div>
</div>

<script>
  import EmblaCarousel from 'embla-carousel';

  const viewport = document.getElementById('embla-viewport') as HTMLElement;
  const prevBtn = document.getElementById('embla-prev') as HTMLButtonElement;
  const nextBtn = document.getElementById('embla-next') as HTMLButtonElement;

  const embla = EmblaCarousel(viewport, { loop: true, dragFree: false });

  prevBtn.addEventListener('click', () => embla.scrollPrev());
  nextBtn.addEventListener('click', () => embla.scrollNext());
</script>
